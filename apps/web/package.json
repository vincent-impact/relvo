{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../../scripts/generate-suivi.mjs",
    "dev": "next dev",
    "prebuild": "node ../../scripts/generate-suivi.mjs",
    "build": "next build",
    "vercel-build": "pnpm --filter @relvo/db migrate:deploy && pnpm --filter @relvo/db seed:ensure && pnpm build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:extraire": "node --env-file=.env.local --import tsx scripts/evaluation/extraire.ts",
    "eval:tri": "node --env-file=.env.local --import tsx scripts/evaluation/lancer.ts",
    "eval:structuration": "node --env-file=.env.local --import tsx scripts/evaluation/structurer.ts",
    "eval:brouillon": "node --env-file=.env.local --import tsx scripts/evaluation/brouillonner.ts",
    "eval:relecture": "node --env-file=.env.local --import tsx scripts/evaluation/relire.ts",
    "eval:echange": "node --env-file=.env.local --import tsx scripts/evaluation/echanger.ts",
    "eval:dictee": "node --env-file=.env.local --import tsx scripts/evaluation/dicter.ts",
    "ia:journal": "node --env-file=.env.local --import tsx scripts/ia/journal.ts",
    "ia:assistant": "node --env-file=.env.local --import tsx scripts/ia/activer-assistant.ts",
    "push:essai": "node --env-file=.env.local --import tsx scripts/push/essai.ts",
    "admin:role": "node --env-file=.env.local --import tsx scripts/admin/role.ts",
    "pj:rattraper": "node --env-file=.env.local --import tsx scripts/unipile/pieces-jointes.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/react": "^4.0.146",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@relvo/db": "workspace:*",
    "@relvo/storage": "workspace:*",
    "ai": "^7.0.99",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unipile-node-sdk": "^1.9.3",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
